{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "verify",
  "main": "./worker.js",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "certificate_verification",
